# starpivot-astroai 配置模板 — 复制为 .env 使用
# ══════════════════════════════════════
# 模型层(模型无关设计, 三选一或配多个自动降级)
# 本地Ollama(默认, 离线保底)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# 云端加速(可选, 二选一)
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
# 模型路由: auto=本地优先云端兜底 / local=纯离线 / cloud=云端优先
MODEL_ROUTE=auto
# ★ 任意模型接入(OpenAI兼容, JSON数组, 想接几个接几个):
# STARPIVOT_CHANNELS=[{"名":"通义","base":"https://dashscope.aliyuncs.com/compatible-mode/v1","key":"sk-xxx","model":"qwen-plus"},{"名":"Kimi","base":"https://api.moonshot.cn/v1","key":"sk-xxx","model":"moonshot-v1-8k"},{"名":"OpenRouter","base":"https://openrouter.ai/api/v1","key":"sk-xxx","model":"anthropic/claude-3.5-sonnet"},{"名":"本地vLLM","base":"http://192.168.1.100:8000/v1","key":"none","model":"Qwen2.5-32B"}]
STARPIVOT_CHANNELS=

# NINA Advanced-API
NINA_API_HOST=127.0.0.1
NINA_API_PORT=1888
# Mock模式: true=无NINA时用模拟数据开发 / false=真机
NINA_MOCK=true

# 天气插件(AI-Weather)
WEATHER_SOURCE=aiweather

# 服务端口
STARPIVOT_PORT=8899

{
  "工具版本": "V1.0",
  "说明": "星枢中文MCP工具库 — 高频核心8类, 全中文Schema, 自研执行",
  "工具集": {
    "相机": {
      "制冷控制": {
        "参数": {"目标温度": {"类型": "数字", "范围": [-50, 25], "单位": "℃", "必填": true},
                  "是否开启": {"类型": "布尔", "默认": true}},
        "返回": "当前温度、制冷功率、是否已达目标",
        "风险级": "中"
      },
      "单次曝光": {
        "参数": {"曝光时长": {"类型": "数字", "范围": [0.1, 3600], "单位": "秒", "必填": true},
                  "增益": {"类型": "整数", "默认": 120},
                  "偏置": {"类型": "整数", "默认": 10},
                  "是否保存": {"类型": "布尔", "默认": false}},
        "返回": "曝光结果(帧统计/平均/中位数)或文件路径",
        "风险级": "低"
      },
      "读取参数": {
        "参数": {},
        "返回": "温度/增益/偏置/像元尺寸/ROI等全量中文参数表",
        "风险级": "无"
      }
    },
    "赤道仪": {
      "GOTO转向": {
        "参数": {"目标": {"类型": "文本", "说明": "目标名(M31/心宿二)或赤道坐标", "必填": true}},
        "返回": "转向结果、当前赤经赤纬、是否到位",
        "风险级": "中"
      },
      "跟踪开关": {
        "参数": {"是否开启": {"类型": "布尔", "必填": true}, "跟踪模式": {"类型": "文本", "枚举": ["恒星", "月球", "太阳", "自定义"], "默认": "恒星"}},
        "返回": "跟踪状态",
        "风险级": "中"
      },
      "停泊": {
        "参数": {"执行": {"类型": "布尔", "默认": true}},
        "返回": "停泊执行结果与位置",
        "风险级": "中"
      },
      "寻找home": {
        "参数": {},
        "返回": "归零结果",
        "风险级": "中"
      },
      "坐标同步": {
        "参数": {"赤经": {"类型": "文本", "示例": "00:42:44"}, "赤纬": {"类型": "文本", "示例": "+41:16:09"}},
        "返回": "同步结果",
        "风险级": "中"
      }
    },
    "调焦座": {
      "移动": {
        "参数": {"步数": {"类型": "整数", "范围": [-50000, 50000], "必填": true}, "方向": {"类型": "文本", "枚举": ["内", "外"], "默认": "外"}},
        "返回": "移动后位置",
        "风险级": "低"
      },
      "全自动对焦": {
        "参数": {"曝光时长": {"类型": "数字", "默认": 3, "单位": "秒"}, "滤镜": {"类型": "文本", "默认": "当前"}},
        "返回": "对焦曲线结果/最终HFR/移动步数/耗时",
        "风险级": "低"
      }
    },
    "滤镜轮": {
      "切换": {
        "参数": {"滤镜": {"类型": "文本", "枚举": ["L", "R", "G", "B", "Ha", "OIII", "SII", "位置序号"], "必填": true}},
        "返回": "当前滤镜位置与名称",
        "风险级": "低"
      },
      "读取位置": {"参数": {}, "返回": "当前位置/名称/全部滤镜列表", "风险级": "无"}
    },
    "导星": {
      "启停": {
        "参数": {"是否开启": {"类型": "布尔", "必填": true}},
        "返回": "导星状态/RMS误差",
        "风险级": "中"
      },
      "Dither抖动": {
        "参数": {"像素": {"类型": "整数", "默认": 2}, "是否仅 settle 后": {"类型": "布尔", "默认": true}},
        "返回": "抖动执行与收敛结果",
        "风险级": "低"
      }
    },
    "星点解析": {
      "拍摄并解析": {
        "参数": {"曝光时长": {"类型": "数字", "默认": 5, "单位": "秒"}},
        "返回": "解析结果/赤经赤纬/像素比例/置信度/是否同步建议",
        "风险级": "低"
      }
    },
    "序列": {
      "启停控制": {
        "参数": {"操作": {"类型": "文本", "枚举": ["启动", "停止", "暂停", "继续"], "必填": true}},
        "返回": "序列状态/当前进度/已拍张数",
        "风险级": "高"
      }
    },
    "全局状态": {
      "读取总览": {
        "参数": {"明细": {"类型": "文本", "枚举": ["概要", "全部"], "默认": "概要"}},
        "返回": "HFR/CCD温度/环境温度/设备在线/导星RMS/序列进度",
        "风险级": "无"
      }
    }
  },
  "未实现工具统一占位": "该工具暂未实现, 已记录需求, 将在后续版本支持",
  "风险策略": {
    "高": "需二次确认或处于自动模式下才执行",
    "中": "执行前检查设备安全状态",
    "低": "直接执行",
    "无": "只读"
  }
}
